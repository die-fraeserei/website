---
// One row of the /projekte overview ("zigzag" layout): large cover, alternating left/right on desktop.
import Image from '~/components/common/Image.astro';
import { formatProjectDate, type Project } from '~/utils/projects';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  project: Project;
  reversed?: boolean;
  /** First item loads eagerly (above the fold). */
  eager?: boolean;
}

const { project, reversed = false, eager = false } = Astro.props;
const { title, date, category, tags = [], teaser, cover, coverAlt } = project.data;
const href = getPermalink(`/projekte/${project.id}`);
---

<article class="grid gap-6 md:grid-cols-12 md:gap-10 items-center py-8 md:py-10 border-b border-line last:border-b-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
  <a
    href={href}
    class:list={['md:col-span-7 block overflow-hidden rounded-xl shadow-md group', { 'md:order-2': reversed }]}
    tabindex="-1"
    aria-hidden="true"
  >
    <Image
      src={cover}
      alt={coverAlt}
      class="w-full aspect-video object-cover transition duration-300 group-hover:scale-[1.03]"
      width={1200}
      height={675}
      widths={[480, 768, 1200]}
      sizes="(max-width: 767px) 100vw, 58vw"
      layout="cover"
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
    />
  </a>
  <div class="md:col-span-5">
    <p class="text-sm text-muted">
      <time datetime={date.toISOString()}>{formatProjectDate(date)}</time>
    </p>
    <h2 class="mt-1 font-heading font-extrabold uppercase text-3xl md:text-4xl leading-none text-heading">
      <a href={href} class="hover:text-primary">
        {title}
      </a>
    </h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {[category, ...tags].map((chip) => (
        <li class="rounded-full bg-surface px-2.5 py-0.5 text-xs font-semibold text-primary">{chip}</li>
      ))}
    </ul>
    <p class="mt-4 text-muted text-lg">{teaser}</p>
    <a href={href} class="mt-4 inline-block font-semibold text-primary hover:underline underline-offset-4">
      Projekt ansehen →
    </a>
  </div>
</article>
