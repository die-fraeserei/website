---
// Contact block for the home page (v1: mailto / tel only, no form – GitHub Pages is static).
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { BUSINESS, phoneHref } from '~/data/business';

export interface Props {
  id?: string;
}

const { id = 'kontakt' } = Astro.props;

const mailSubject = encodeURIComponent('Anfrage über die-fraeserei.de');
const items = [
  {
    icon: 'tabler:mail',
    label: 'E-Mail',
    text: BUSINESS.email,
    href: `mailto:${BUSINESS.email}?subject=${mailSubject}`,
  },
  ...(BUSINESS.phone
    ? [{ icon: 'tabler:phone', label: 'Telefon', text: BUSINESS.phone, href: phoneHref(BUSINESS.phone) }]
    : []),
  ...(BUSINESS.region ? [{ icon: 'tabler:map-pin', label: 'Standort', text: BUSINESS.region, href: undefined }] : []),
];
---

<WidgetWrapper id={id} containerClass="max-w-5xl">
  <Headline
    tagline="Kontakt"
    title="Projekt im Kopf?"
    subtitle="Schicke mir eine kurze Beschreibung, gern mit Skizze oder Datei (DXF, SVG, STEP). Ich melde mich mit einer Einschätzung zu Machbarkeit, Material und Preis."
  />
  <div class="flex flex-wrap justify-center gap-4">
    {
      items.map(({ icon, label, text, href }) => {
        const Tag = href ? 'a' : 'div';
        return (
          <Tag
            href={href}
            class:list={[
              'flex w-full sm:w-80 items-center gap-4 rounded-xl border border-line bg-card p-5 transition',
              { 'hover:border-primary hover:shadow-md': href },
            ]}
          >
            <Icon name={icon} class="w-11 h-11 p-2.5 rounded-lg bg-accent/30 text-primary shrink-0" />
            <span class="min-w-0">
              <span class="block text-sm text-muted">{label}</span>
              <span class="block font-semibold break-words">{text}</span>
            </span>
          </Tag>
        );
      })
    }
  </div>
  <div class="mt-10 text-center">
    <a class="btn-primary" href={`mailto:${BUSINESS.email}?subject=${mailSubject}`}>
      Anfrage per E-Mail senden
      <Icon name="tabler:send" class="w-5 h-5 ml-2" />
    </a>
  </div>
</WidgetWrapper>
