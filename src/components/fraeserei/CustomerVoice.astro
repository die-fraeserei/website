---
// "Stimme des Kunden": optional testimonial at the end of a project page.
// Only publish names and quotes with the customer's consent.
export interface Props {
  quote: string;
  name: string;
  role?: string;
}

const { quote, name, role } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<figure class="relative mt-16 rounded-2xl bg-surface px-6 py-10 md:px-12">
  <span
    aria-hidden="true"
    class="absolute -top-8 left-6 md:left-10 font-serif text-[7rem] leading-none text-accent select-none"
  >
    “
  </span>
  <p class="text-xs font-bold uppercase tracking-widest text-secondary">Stimme des Kunden</p>
  <blockquote class="mt-3 text-xl md:text-2xl font-medium leading-relaxed text-heading">
    <p>„{quote}“</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3 text-sm">
    <span
      class="grid h-11 w-11 place-items-center rounded-full bg-primary font-heading font-bold text-[var(--aw-color-bg-page)]"
      aria-hidden="true"
    >
      {initials}
    </span>
    <span>
      <span class="block font-semibold">{name}</span>
      {role && <span class="block text-muted">{role}</span>}
    </span>
  </figcaption>
</figure>
